{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mina-analytics.example/tgc/adapter.schema.json",
  "title": "TGC benchmark adapter descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_version",
    "name",
    "instance_key",
    "spec_root",
    "output_root",
    "artifact_root",
    "deployment_profile",
    "selftest"
  ],
  "properties": {
    "adapter_version": {"const": "tgc-adapter/1.0.0"},
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {"type": "string", "maxLength": 2000},
    "instance_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 100
    },
    "spec_root": {"$ref": "#/$defs/relativePath"},
    "output_root": {"$ref": "#/$defs/relativePath"},
    "artifact_root": {"$ref": "#/$defs/relativeOrDot"},
    "deployment_profile": {"$ref": "#/$defs/relativePath"},
    "checker_cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "payload", "expected_verdict"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "payload": {"type": "object"},
          "expected_verdict": {"enum": ["PASS", "REFUTED", "UNKNOWN"]},
          "expected_supported_targets": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "certificate_contains": {"type": "object"}
        }
      }
    },
    "selftest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_slug", "expected_lane", "expected_metrics", "record"],
      "properties": {
        "session_slug": {"type": "string", "minLength": 1},
        "expected_lane": {"type": "string", "minLength": 1},
        "expected_metrics": {"type": "object"},
        "record": {"type": "object"}
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {"pattern": "^[A-Za-z]:[\\\\/]"},
          {"pattern": "^/"},
          {"pattern": "^\\\\\\\\"},
          {"pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"}
        ]
      }
    },
    "relativeOrDot": {
      "anyOf": [
        {"const": "."},
        {"$ref": "#/$defs/relativePath"}
      ]
    }
  }
}

