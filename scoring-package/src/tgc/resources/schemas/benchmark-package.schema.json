{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tgc/benchmark-package.schema.json",
  "title": "TGC portable benchmark package descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "name",
    "version",
    "spec_root",
    "generated_root"
  ],
  "properties": {
    "format": {
      "const": "tgc-benchmark-package/1.0.0"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "spec_root": {
      "$ref": "#/$defs/relativePath"
    },
    "generated_root": {
      "$ref": "#/$defs/relativePath"
    },
    "artifact_root": {
      "$ref": "#/$defs/relativeOrDot"
    },
    "checker_fixtures": {
      "$ref": "#/$defs/relativePath"
    },
    "instance_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "strict_portability": {
      "type": "boolean"
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {"pattern": "^[A-Za-z]:[\\\\/]"},
          {"pattern": "^/"},
          {"pattern": "^\\\\\\\\"},
          {"pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"}
        ]
      }
    },
    "relativeOrDot": {
      "anyOf": [
        {"const": "."},
        {"$ref": "#/$defs/relativePath"}
      ]
    }
  }
}
