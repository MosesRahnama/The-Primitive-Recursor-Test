{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mina-analytics.example/tgc/checker-result.schema.json",
  "title": "TGC native checker result",
  "type": "object",
  "additionalProperties": true,
  "required": ["verdict", "detail", "compliant", "certificate"],
  "properties": {
    "verdict": {"enum": ["PASS", "REFUTED", "UNKNOWN"]},
    "detail": {"type": "string"},
    "compliant": {"type": "boolean"},
    "certificate": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["certificate_type"],
          "properties": {
            "certificate_type": {"type": "string", "minLength": 1},
            "supported_targets": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "PASS"}}},
      "then": {
        "properties": {
          "certificate": {
            "type": "object",
            "required": ["certificate_type", "supported_targets"],
            "properties": {
              "supported_targets": {"type": "array", "minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"enum": ["PASS", "REFUTED"]}}},
      "then": {"properties": {"certificate": {"type": "object"}}}
    }
  ]
}

